  "styles": {
    "base": {"file": "BebasNeue-Regular.ttf", "family": "Bebas Neue", "style": "Regular", "color": "#ffffff", "upper": true},
    "emph": {"file": "Anton-Regular.ttf", "family": "Anton", "style": "Regular", "color": "#ffe27a", "upper": true},
    "m4": {"file": "manrope-400.ttf", "family": "Manrope", "style": "Regular", "color": "#ffffff", "upper": false},
    "m7": {"file": "manrope-700.ttf", "family": "Manrope", "style": "Bold", "color": "#ffffff", "upper": false},
    "g": {"file": "editorial-bold-italic.ttf", "family": "Georgia", "style": "Bold Italic", "color": "#fff0cf", "upper": false},
